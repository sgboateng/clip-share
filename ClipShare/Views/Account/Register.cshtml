@model ClipShare.ViewModels.Account.Register_vm

@{
    ViewData["Title"] = "Registration Page";
}

<div class="d-flex justify-content-center">
    <div class="col-lg-5">
        <main class="form-signin">
            <form method="post">
                <div class=" text-center my-4">
                    <h1 class="h3 font-weight-normal"> SignUp today to watch free <span class="text-danger">Clips</span></h1>
                </div>

                <div class="form-floating mt-5 mb-3">
                    <input asp-for="FullName" placeholder="Full Name" class="form-control" />
                    <label asp-for="FullName"></label>
                    <span asp-validation-for="FullName" class="invalid-feedback"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Username" placeholder="User Name" class="form-control" />
                    <label asp-for="Username"></label>
                    <span asp-validation-for="Username" class="invalid-feedback"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Email" placeholder="Email Address" class="form-control" />
                    <label asp-for="Email"></label>
                    <span asp-validation-for="Email" class="invalid-feedback"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Password" type="password" placeholder="Password" class="form-control" />
                    <label asp-for="Password"></label>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="ConfirmPassword" type="password" placeholder="Confirm Password" class="form-control" />
                    <label asp-for="ConfirmPassword"></label>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <div class="form-floating">
                    <div asp-validation-summary="All" class="text-danger"></div>
                </div>

                <div class="d-grid mt-4 px-1">
                    <button class="btn btn-lg btn-warning" type="submit">
                        Register
                    </button>
                </div>
            </form>
        </main>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
